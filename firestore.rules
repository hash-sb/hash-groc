rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allows signed-in family members with a Google account to access household lists
    match /households/{householdId} {
      allow read, write: if request.auth != null;

      match /items/{itemId} {
        allow read, write: if request.auth != null;
      }

      match /shops/{shopId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
