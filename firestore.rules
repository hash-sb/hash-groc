rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: Require an authenticated Firebase user (Google Sign-In)
    function isSignedIn() {
      return request.auth != null;
    }

    // Household root document & subcollections (items, shops, receipts)
    match /households/{householdId} {
      // Allow authenticated users to read/update their household or join via invite code query
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if false; // Prevent accidental full household deletion from client

      match /items/{itemId} {
        allow read, write: if isSignedIn();
      }

      match /shops/{shopId} {
        allow read, write: if isSignedIn();
      }

      match /receipts/{receiptId} {
        allow read, write: if isSignedIn();
      }
    }
  }
}
